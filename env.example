# CDP Configuration (kept for now — Phase 4 will remove)
VITE_CDP_PROJECT_ID=example-id

# Ethereum Account type: "eoa" for regular accounts, "smart" for Smart Accounts
VITE_CDP_CREATE_ETHEREUM_ACCOUNT_TYPE=eoa
# Whether to create a Solana Account
VITE_CDP_CREATE_SOLANA_ACCOUNT=false

# --- mppx (Tempo Machine Payments Protocol) ---
# HMAC secret for stateless credential verification.
# Any random ≥32-byte hex string works. Generate with:
#   openssl rand -hex 32
MPP_SECRET_KEY=

# Server fee-payer key. Funds gas (in pathUSD) when co-signing client charges.
# Use a fresh dev wallet, fund it from https://wallet.tempo.xyz with pathUSD.
MPPX_PRIVATE_KEY=

# --- agent (autonomous sender, /agent route) ---
ANTHROPIC_API_KEY=
AGENT_WALLET_PRIVATE_KEY=

# --- Upstash Redis (creators + messages) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Resend (forward messages to creator email) ---
RESEND_API_KEY=
